{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "silently-remove-extras",
  "controllerPathGlobs": ["src/api/*.controller.ts"],
  "spec": {
    "outputDirectory": "./src/api/generated/spec",
    "specVersion": 3,
    "securityDefinitions": {
        "JWT": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header",
            "description": "Token obtido a partir de /api/auth/login no formato \"Bearer {token}\""
        }
    }
  },
  "routes": {
    "routesDir": "./src/api/generated/routes",
    "authenticationModule": "./src/api/guards/express.auth.ts"
  }
}
