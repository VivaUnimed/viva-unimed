import {Table, Column, Model,  DataType, ForeignKey,BelongsTo, DefaultScope, AllowNull, PrimaryKey} 
from 'sequelize-typescript';

import DoctorModel from "./doctor.model"; 
import QueueWaitingModel from  "./QueueWaiting.model";
export interface IDoctorAvailability {
  id: string;
  doctorsId: number;
  queueWaitingId: number;
  mounthDay: Date;
  startTime: string;
  endTime: string;
}


export interface IDoctorAvailabilityCreate extends Omit<IDoctorAvailability, 'id'> {}

@Table({
  tableName: "DoctorAvailability",
  paranoid: true,
  underscored: true, // Recomendado para converter camelCase em snake_case no Postgres
  defaultScope: {
    attributes: { exclude: ['createdAt', 'updatedAt', 'deletedAt'] }
  },
})
export default class DoctorAvailabilityModel extends Model<IDoctorAvailability, IDoctorAvailabilityCreate> {
  
  @PrimaryKey (() => DoctorAvailabilityModelModel)
  @Default(DataType.UUIDV4)
  @Column(DataType.UUID)
  declare id: string;

  @ForeignKey(() => DoctorModel)
  @Column({ type: DataType.INTEGER, allowNull: false })
  declare doctorsId: number;

  @ForeignKey(() => QueueWaitingModel)
  @Column({ type: DataType.INTEGER, allowNull: false })
  declare queueWaitingId: number;

  @Column({ type: DataType.DATE, allowNull: false })
  declare mounthDay: Date;

  @Column({ type: DataType.TIME, allowNull: false })
  declare startTime: string;

  @Column({ type: DataType.TIME, allowNull: false })
  declare endTime: string;

  
  @BelongsTo(() => DoctorModel)
  declare doctorId: DoctorModel;

  @BelongsTo(() => QueueWaitingModel)
  declare QueueWaitingId: QueueWaitingModel;
}